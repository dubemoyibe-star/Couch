generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Every model uses a string id generated by Prisma: `@default(uuid(7))`.
// UUIDv7 values are time-ordered, so new rows land at the end of the primary
// key index, and they are opaque, so ids do not leak row counts.

// User record, authenticated through Better Auth's Prisma adapter.
//
// Schema reconciliation (see docs/DEVELOPMENT.md): Better Auth's Prisma
// adapter conventionally expects a `name` field. This model keeps the
// existing `displayName` field instead of adding a second, overlapping name
// field: apps/web/src/lib/auth.ts configures the adapter with
// `user: { fields: { name: "displayName" } }`, which points the adapter's
// `name` concept at this column. The existing id strategy and the unique
// email constraint are unchanged.
model User {
  id            String   @id @default(uuid(7))
  email         String   @unique
  displayName   String
  // Required by Better Auth's adapter. Email/password sign-ups start false and
  // flip to true when the emailed link is opened; Google sign-ups start true
  // when Google vouches for the address. A user with this false is refused a
  // session on both paths (apps/web/src/lib/auth.ts).
  emailVerified Boolean  @default(false)
  // Required by Better Auth's adapter (a user avatar URL). Nothing in this
  // app sets it yet.
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedCouches     Couch[]
  couchMemberships CouchMember[]
  sessions         Session[]
  accounts         Account[]
}

// A Better Auth session token. Deletes: cascades with its User
// (`onDelete: Cascade`), matching Better Auth's documented schema. The only
// user delete (`deleteUnverifiedUser`) refuses a user that has a session.
model Session {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A linked sign-in method for a User: a credential (email/password) or an
// external provider account. Better Auth stores password sign-in as an
// Account row with providerId "credential". Deletes: cascades with its User
// (`onDelete: Cascade`), matching Better Auth's documented schema. The only
// user delete (`deleteUnverifiedUser`) removes the accounts of the unverified
// user it deletes.
model Account {
  id                    String    @id @default(uuid(7))
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// A pending verification request (for example an email verification or
// password reset token). Not tied to a User by foreign key: Better Auth
// looks these up by `identifier`.
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// The verified licensing basis of one media item. The fields mirror the
// contracts `LicenseRecord`, and every value is entered by someone who verified
// the source: nothing is guessed or filled in by code.
//
// Deletes: a license row is owned by exactly one Media row and is never deleted
// on its own. The relation from Media uses `onDelete: Restrict`, so the database
// refuses to delete a license row that a media row still references.
model LicenseRecord {
  id                     String   @id @default(uuid(7))
  licenseName            String
  licenseVersion         String?
  licenseUrl             String
  sourceUrl              String
  rightsholder           String?
  attributionRequired    Boolean
  attribution            String?
  intendedUseAllowed     Boolean
  commercialUseAllowed   Boolean
  additionalRestrictions String?
  // A calendar date (Postgres `date`, no time part). Prisma hands it over as a
  // JavaScript Date at UTC midnight, so it is always read and written through
  // the UTC date parts, never the process time zone.
  verifiedAt             DateTime @db.Date
  verificationNotes      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  media Media?
}

// One item a provider offers. The catalog stores metadata and a link to the
// poster only. It never stores a playback URL: playback sources are resolved
// through the provider at request time because they can expire.
//
// A media row cannot exist without a license row: `licenseRecordId` is required
// and unique, so the link is one-to-one and enforced by the database.
//
// Deletes: there is no hard delete of Media. A takedown sets `isActive` to
// false, and the row and its license stay as a record. The catalog repository
// exports no delete. Should a delete ever be added, it must remove the media row
// first and its license row in the same transaction, because the license
// relation is `onDelete: Restrict` and cannot be removed while media points at it.
model Media {
  id              String   @id @default(uuid(7))
  providerId      String
  // The provider's own id. Opaque: it is stored exactly as given.
  providerMediaId String
  title           String
  description     String?
  // SECONDS. Prisma `Float` is Postgres double precision.
  durationSeconds Float?
  posterUrl       String?
  releaseYear     Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  licenseRecordId String        @unique
  licenseRecord   LicenseRecord @relation(fields: [licenseRecordId], references: [id], onDelete: Restrict)
  couchesWatching Couch[]

  @@unique([providerId, providerMediaId])
}

// A watch party. Playback state (status, position, rate, revision) is NOT
// stored here: it is ephemeral, held in the realtime service's memory, and
// resets when that process restarts. Only the couch's durable identity and
// membership are in the database.
//
// Deletes: there is no couch delete function in the MVP, so a delete's
// downstream effect is a schema decision, not a runtime one.
model Couch {
  id         String @id @default(uuid(7))
  name       String
  ownerId    String
  // The user who created the couch. The only user delete
  // (`deleteUnverifiedUser`) checks for owned couches first, and a delete is
  // refused (`onDelete: Restrict`) rather than guessed at.
  owner      User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  inviteCode String @unique

  // Whether the couch is listed for anyone to find. Private by default. Only
  // a host changes it (`setCouchVisibility`).
  isPublic Boolean @default(false)

  // Whether the couch refuses new members. Existing members are unaffected.
  // Only a host changes it (`setCouchClosed`).
  isClosed Boolean @default(false)

  currentMediaId String?
  // The media the couch is currently watching, or null for none. Media has no
  // delete function either, but a takedown sets `Media.isActive` to false
  // without removing the row, so this stays a normal foreign key that clears
  // itself (`onDelete: SetNull`) if a Media row is ever removed by another
  // path. Callers must still resolve this id through `getCatalogMedia` on every
  // read: it can point at media that is no longer authorized or active, and
  // that must be treated the same as null (see the database README).
  currentMedia   Media?  @relation(fields: [currentMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CouchMember[]
}

enum CouchRole {
  HOST
  PARTICIPANT
}

// One user's membership in one couch. Host transfer is out of scope: a couch
// keeps exactly the host it was created with for the life of this schema.
//
// Deletes: a membership has no existence apart from its couch, so removing a
// couch removes its memberships (`onDelete: Cascade` on `couchId`), even
// though no couch delete function exists yet. A user cannot be deleted while
// they still hold a membership (`onDelete: Restrict` on `userId`), so the only
// user delete (`deleteUnverifiedUser`) refuses a user that holds one.
model CouchMember {
  id       String    @id @default(uuid(7))
  couchId  String
  couch    Couch     @relation(fields: [couchId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     CouchRole
  joinedAt DateTime  @default(now())

  @@unique([couchId, userId])
  @@index([couchId])
  @@index([userId])
}
