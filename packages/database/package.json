{
  "name": "@couch/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth-core": "./src/auth-core.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-dev.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:migrate:deploy:test": "prisma migrate deploy --config prisma.test.config.ts && prisma generate",
    "db:reset:test": "prisma migrate reset --config prisma.test.config.ts"
  },
  "dependencies": {
    "@couch/contracts": "workspace:*",
    "@couch/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prisma": "7.10.0"
  }
}
