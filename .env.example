# Copy the values you need into .env.local (dev) and .env.test (test) at the
# repo root. Both files are gitignored. Never put production credentials in
# either file. See docs/DEVELOPMENT.md.

# Runtime connection: the Neon POOLED string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/DATABASE_NAME?sslmode=verify-full"

# Prisma CLI connection: the Neon DIRECT string (same host without "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/DATABASE_NAME?sslmode=verify-full"

# One of: dev, test, prod. .env.local sets dev and .env.test sets test.
COUCH_DB_ENV=dev

# Better Auth. Generate a secret with `openssl rand -base64 32`; never commit
# the real value. BETTER_AUTH_URL is the app's own base URL.
BETTER_AUTH_SECRET="PLACEHOLDER"
BETTER_AUTH_URL="http://localhost:3000"

# Resend (transactional email). Create an API key in the Resend dashboard;
# never commit the real value.
RESEND_API_KEY="PLACEHOLDER"

# Google OAuth (Sign in with Google). Create an OAuth client (type "Web
# application") in the Google Cloud Console. Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google, for example
# http://localhost:3000/api/auth/callback/google. Never commit real values.
GOOGLE_CLIENT_ID="PLACEHOLDER"
GOOGLE_CLIENT_SECRET="PLACEHOLDER"

# Shared secret for service-to-service calls from apps/web to apps/realtime
# (for example tearing down a deleted couch's room). Set the same value for both
# apps. Generate one with `openssl rand -base64 32`; never commit the real value.
# The realtime service refuses to start without it.
REALTIME_INTERNAL_SECRET="PLACEHOLDER"
# Base URL apps/web uses to reach the realtime service's internal endpoints.
REALTIME_INTERNAL_URL="http://localhost:3001"
